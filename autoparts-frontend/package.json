{
  "name": "autoparts-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.2",
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@autoparts/web",
    "dev:mobile": "turbo run dev --filter=@autoparts/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "expo-router": "~57.0.22",
    "react-native": "^0.86.3",
    "tailwindcss": "^4.1.12",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
