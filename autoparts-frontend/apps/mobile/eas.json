{
  "cli": { "version": ">= 13.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "http://localhost:3000",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS": ""
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS": ""
      }
    }
  },
  "submit": { "production": {} }
}
