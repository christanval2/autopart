  usecase "Gérer catégories et marques" as u73
  usecase "Modérer les produits" as u74
  usecase "Modérer avis et Q&R" as u75
  usecase "Arbitrer les litiges" as u76
  usecase "Gérer les codes promo" as u77
  usecase "Consulter le journal d'audit" as u78
  usecase "Gérer la newsletter" as u79
  usecase "Consulter les analytics globaux" as u80
  usecase "Impersoner un utilisateur" as u81
}

