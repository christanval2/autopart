@startuml use-case-marketplace
left to right direction
skinparam shadowing false
skinparam usecaseFontSize 15
skinparam actorFontSize 16
skinparam stereotypeFontSize 13
skinparam ArrowThickness 1.5

' ===== Acteurs principaux =====
actor "Visiteur" as V
actor "Utilisateur" as U <<abstrait>>
actor "Client" as C
actor "Responsable\nachat (B2B)" as RA
actor "Vendeur" as VE
actor "Responsable\nboutique" as RB
actor "Agent\nlogistique" as LI
actor "Comptable" as CO
actor "Administrateur" as AD

' ===== Acteurs secondaires (systèmes externes réels) =====
actor "API Paiement\n(MTN MoMo / Orange)" as PAY
actor "API Groq (IA)" as IA
actor "Service Push\nExpo / Socket.io" as PUSH

rectangle "Marketplace pièces auto" {

  ' --- Visiteur ---
  usecase "Parcourir le catalogue" as u1
  usecase "Rechercher des produits" as u2
  usecase "Rechercher par VIN" as u3
  usecase "Rechercher par photo (OCR)" as u4
  usecase "Consulter un produit" as u5
  usecase "Consulter les vendeurs à proximité" as u6
  usecase "Suivre un colis" as u7
  usecase "S'inscrire" as u8
  usecase "Consulter le contenu légal" as u9
  usecase "Utiliser le chatbot IA" as u10

  ' --- Utilisateur (hérité par tous) ---
  usecase "S'authentifier (2FA)" as u11
  usecase "Gérer son profil" as u12
  usecase "Utiliser la messagerie" as u13
  usecase "Recevoir des notifications" as u14
  usecase "Gérer ses données (RGPD)" as u15

  ' --- Client ---
  usecase "Gérer son panier" as u16
