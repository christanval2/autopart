# ─── LiveKit (identiques au backend) ──────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Groq (STT Whisper + LLM) ────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxx
# llama-3.3 retiré du catalogue Groq — gpt-oss-20b vérifié disponible
GROQ_LLM_MODEL=openai/gpt-oss-20b

# ─── TTS Piper (voix française locale — aucune clé) ───────────
# Téléchargée par : python download_voices.py
# Autres voix : fr_FR-upmc-high.onnx, fr_FR-tom-medium.onnx
PIPER_VOICE=/chemin/vers/fr_FR-siwis-medium.onnx

# ─── Backend AutoParts ─────────────────────────────────────────
# L'agent appelle {BACKEND_URL}/voice-order/order avec le JWT
# transmis par le backend dans les métadonnées de la room.
BACKEND_URL=http://localhost:3000/api/v1
