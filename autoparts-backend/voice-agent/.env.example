# ─── LiveKit (identiques au backend) ──────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Groq AI (STT Whisper + LLM LLaMA + TTS) ──────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# ─── Backend AutoParts ─────────────────────────────────────────
# L'agent appelle {BACKEND_URL}/voice-order/order avec le JWT
# transmis par le backend dans les métadonnées de la room.
BACKEND_URL=http://localhost:3000/api/v1
