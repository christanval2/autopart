{
  "name": "autoparts-marketplace-api",
  "version": "1.0.0",
  "description": "API REST Marketplace B2B/B2C pièces automobiles — Cameroun",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node --transpile-only -r tsconfig-paths/register src/server.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "dev:fresh": "node scripts/dev-fresh.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:unit": "jest src/__tests__/unit --coverage",
    "test:integration": "RUN_INTEGRATION=1 jest tests/all.test.ts tests/org-type-rules.test.ts src/__tests__/integration --runInBand",
    "migration:generate": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate migrations/$npm_config_name -d src/data-source.ts",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:show": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/data-source.ts",
    "schema:drift": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:log -d src/data-source.ts",
    "db:setup": "npm run migration:run && npm run seed",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register src/database/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":50,\"functions\":60,\"lines\":60}}'",
    "seed:demo": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-demo.ts",
    "seed:produits": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-assetproduits.ts"
  },
  "dependencies": {
    "@livekit/agents": "^1.5.5",
    "@sentry/node": "^8.22.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.3",
    "class-transformer": "^0.5.1",
    "cloudinary": "^2.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^11.1.0",
    "groq-sdk": "^0.6.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.17.0",
    "module-alias": "^2.2.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.7.5",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.15",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.5.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "_moduleAliases": {
    "@modules": "dist/modules",
    "@entities": "dist/entities",
    "@shared": "dist/shared",
    "@config": "dist/config",
    "@jobs": "dist/jobs"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
