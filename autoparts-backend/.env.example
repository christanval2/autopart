# ═══════════════════════════════════════════════════════════
# AUTO PARTS — Modèle de configuration
# Copier vers .env puis remplir avec de vraies valeurs.
# JAMAIS de secret réel dans ce fichier.
# ═══════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/autopart_db
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOGGING=false

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
REDIS_TTL_DEFAULT=300

# ─── JWT (générer : openssl rand -hex 32) ─────────────────
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_HEX
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Crypto (AES-256, exactement 32 caractères) ───────────
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_CHARS

# ─── Storage S3 (MinIO local) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=autoparts
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=eu-west-3

# ─── Email SMTP ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.email@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=no-reply@autoparts.cm

# ─── MTN MoMo ─────────────────────────────────────────────
MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
MOMO_API_KEY=your_momo_api_key
MOMO_SUBSCRIPTION_KEY=your_subscription_key

# ─── Orange Money ─────────────────────────────────────────
ORANGE_API_URL=https://api.orange.com
ORANGE_API_TOKEN=your_orange_token

# ─── Virement bancaire (instructions envoyées aux acheteurs) ──
BANK_NAME=
BANK_RIB=

# ─── Monitoring ───────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── SMS Africa's Talking ─────────────────────────────────
SMS_API_KEY=
SMS_USERNAME=sandbox

# ─── OAuth Social ─────────────────────────────────────────
# ⚠️ Le nom attendu par src/config/env.ts est GOOGLE_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_CALLBACK_URL=https://votre-api.com/api/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Anti-fraude ──────────────────────────────────────────
FRAUD_SCORE_THRESHOLD=60

# ─── Groq AI Chatbot ──────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── Phase 2 — Nouvelles fonctionnalités ──────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── LiveKit Voice Order ──────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# (déprécié — dispatch LiveKit automatique)
VOICE_AGENT_SECRET=

# ─── Production (Render + Neon + Upstash) ─────────────────
# DATABASE_URL : postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# REDIS_URL    : rediss://default:pass@xxx.upstash.io:6379
# APP_URL      : https://autoparts-api.onrender.com
# ALLOWED_ORIGINS : https://<ton-app>.vercel.app
# NB : SSL Postgres activé automatiquement hors localhost (database.ts),
# migrations exécutées au démarrage (migrationsRun en production).
